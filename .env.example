# Copy to .env and fill in. .env is git-ignored; never commit a key.

# Realtime feed (dataset "Delhi Buses GTFS-RT" on delhi.transportstack.in; the key arrives by email)
TRANSPORTSTACK_API_KEY=
TRANSPORTSTACK_FEED_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb

# Only for `busplan google` (validation against Google Maps). Routes API must be enabled.
GOOGLE_MAPS_API_KEY=
